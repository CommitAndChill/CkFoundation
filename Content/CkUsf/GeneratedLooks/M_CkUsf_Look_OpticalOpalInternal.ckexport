				"props":
				{
					"Code": "FCkUsf_SurfaceInput In = CkUsf_DefaultInput();\nIn.Time = Time;\nIn.UV = UV;\nIn.WorldPosition = WorldPosition;\nIn.CameraVector = CameraVector;\nIn.VertexNormal = VertexNormal;\nIn.VertexTangent = VertexTangent;\nIn.PixelDepth = PixelDepth;\nIn.VertexColor = VertexColor;\nFCkUsf_TranslucentStack3Output O = CkUsf_Look_OpticalOpalInternal(In, ColorMap, ColorMapSampler, DomainMap, DomainMapSampler, DomainNormalMap, DomainNormalMapSampler, PolishNormalMap, PolishNormalMapSampler, RoughnessMap, RoughnessMapSampler, MilkColor.rgb, CoatTransmission.rgb, BodyTransmission.rgb, UVScale, UVRotation, ScatteringStrength, DomainNormalStrength, DomainRoughness, FlashReflectance, CoatRoughness, CoatNormalStrength, CoatIor, CoatThicknessCm, CoatReferenceThicknessCm, InternalReflectorThicknessCm, InternalReferenceThicknessCm, BodyThicknessCm, BodyReferenceThicknessCm, RefractionStrength);\nCkUsf_AF0 = O.AF0;\nCkUsf_ARoughness = O.ARoughness;\nCkUsf_ANormal = O.ANormal;\nCkUsf_AEmissiveColor = O.AEmissiveColor;\nCkUsf_BDiffuseAlbedo = O.BDiffuseAlbedo;\nCkUsf_BF0 = O.BF0;\nCkUsf_BRoughness = O.BRoughness;\nCkUsf_BNormal = O.BNormal;\nCkUsf_BEmissiveColor = O.BEmissiveColor;\nCkUsf_CDiffuseAlbedo = O.CDiffuseAlbedo;\nCkUsf_CF0 = O.CF0;\nCkUsf_CRoughness = O.CRoughness;\nCkUsf_CNormal = O.CNormal;\nCkUsf_CEmissiveColor = O.CEmissiveColor;\nCkUsf_ATransmittanceColor = clamp(O.ATransmittanceColor, 0.0001, 0.9999);\nCkUsf_AReferenceThicknessCm = max(O.AReferenceThicknessCm, 0.0001);\nCkUsf_AThicknessCm = max(O.AThicknessCm, 0.0001);\nCkUsf_BTransmittanceColor = clamp(O.BTransmittanceColor, 0.0001, 0.9999);\nCkUsf_BReferenceThicknessCm = max(O.BReferenceThicknessCm, 0.0001);\nCkUsf_BThicknessCm = max(O.BThicknessCm, 0.0001);\nCkUsf_CTransmittanceColor = clamp(O.CTransmittanceColor, 0.0001, 0.9999);\nCkUsf_CReferenceThicknessCm = max(O.CReferenceThicknessCm, 0.0001);\nCkUsf_CThicknessCm = max(O.CThicknessCm, 0.0001);\nCkUsf_RefractionStrength = clamp(O.RefractionStrength, 1.0, 1.1);\nreturn O.ADiffuseAlbedo;",
					"IncludeFilePaths": [
						"/CkUsf/Looks/OpticalOpalInternal.ush"
					]
				}
