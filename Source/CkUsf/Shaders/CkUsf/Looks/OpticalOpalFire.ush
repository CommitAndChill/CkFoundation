// @ckusf surface_graph AdaptiveVertical
#pragma once
#include "/CkUsf/OpticalPair.ush"

FCkUsf_AdaptiveVerticalOutput CkUsf_Look_OpticalOpalFire(FCkUsf_SurfaceInput In,
    Texture2D ColorMap, SamplerState ColorMapSampler,
    Texture2D DomainMap, SamplerState DomainMapSampler,
    Texture2D DomainNormalMap, SamplerState DomainNormalMapSampler,
    Texture2D PolishNormalMap, SamplerState PolishNormalMapSampler,
    Texture2D RoughnessMap, SamplerState RoughnessMapSampler,
    float3 MilkColor, float UVScale, float UVRotation, float MilkAmount,
    float FlashCoverage, float FlashStrength, float DomainNormalStrength,
    float DomainRoughness, float WavelengthShift, float CoatRoughness,
    float CoatNormalStrength, float LayerThicknessCm, float InternalDepthUV, float InternalLayerMix,
    float DetailFilterMip, float FlashReflectance, float BodyColorMix)
{
    float2 SurfaceUV = CkUsf_LibraryUV(In.UV,UVScale,UVRotation);
    float3 View = CkUsf_ViewDirTS(In);
    float3 Ray = refract(-View,float3(0.0,0.0,1.0),1.0/1.45);
    float2 Offset = Ray.xy/max(abs(Ray.z),.5)*clamp(InternalDepthUV,0.0,.025);
    float2 NearUV = saturate(SurfaceUV+Offset);
    float2 FacetUV = frac(NearUV*3.0);
    float2 DeepUV = saturate((SurfaceUV-.5)*.93+.5+Offset*1.8+float2(.07,-.05));
    float Mip = clamp(DetailFilterMip,0.0,5.0);
    float3 NearColor = ColorMap.SampleLevel(ColorMapSampler,NearUV,Mip+1.0).rgb;
    float3 DeepColor = ColorMap.SampleLevel(ColorMapSampler,DeepUV,Mip+3.0).rgb;
    // Facet mask, phase and normal share the same UV and derivative footprint.
    // Only the quiet body below is mixed with the deeper, softer texture sample.
    float3 Data = CkUsf_SampleTexture2D(DomainMap,DomainMapSampler,FacetUV).rgb;
    float Facets = saturate(Data.r*clamp(FlashCoverage,0.0,2.0));
    float Coverage = Facets*saturate(FlashStrength);
    float3 DomainNormal = CkUsf_LibraryNormal(
        CkUsf_SampleTexture2D(DomainNormalMap,DomainNormalMapSampler,FacetUV),
        clamp(DomainNormalStrength,0.0,2.0),UVRotation);
    float3 MineralTint = pow(saturate(NearColor/max(max(NearColor.r,NearColor.g),max(NearColor.b,.001))),3.0);
    float NoV = saturate(dot(View,DomainNormal));
    float3 Spectrum = pow(CkUsf_OpalSpectrum(Data.b*.75+(1.0-NoV)*.4+WavelengthShift),1.3);
    float3 Flash = saturate(lerp(MineralTint,Spectrum,.35));
    float Roughness = CkUsf_SampleTexture2D(RoughnessMap,RoughnessMapSampler,FacetUV).r;
    FCkUsf_AdaptiveVerticalOutput O = CkUsf_DefaultAdaptiveVertical();
    O.ThicknessCm = clamp(LayerThicknessCm,.001,.2);
    O.ADiffuseAlbedo = float3(.12,.12,.11)*saturate(MilkAmount);
    O.AF0 = .04;
    O.ATransmittanceColor = pow(float3(.995,.997,.998),O.ThicknessCm/.04);
    O.ANormal = CkUsf_LibraryNormal(CkUsf_SampleTexture2D(PolishNormalMap,PolishNormalMapSampler,SurfaceUV),CoatNormalStrength,UVRotation);
    O.ARoughness = clamp(CoatRoughness,.02,.6);
    float3 MineralBody = lerp(NearColor,lerp(DeepColor,MilkColor,.45),saturate(InternalLayerMix));
    O.BDiffuseAlbedo = saturate(lerp(MilkColor,MineralBody,saturate(BodyColorMix)));
    O.BF0 = lerp(.035.xxx,Flash*clamp(FlashReflectance,.04,.35),Coverage);
    O.BNormal = DomainNormal;
    // A constant lobe avoids artificial bright rims from blending roughness at mask edges.
    O.BRoughness = clamp(DomainRoughness,.035,.3);
    O.AEmissiveColor = 0.0;
    O.BEmissiveColor = 0.0;
    return O;
}
