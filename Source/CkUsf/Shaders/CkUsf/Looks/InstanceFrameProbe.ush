// /CkUsf/Looks/InstanceFrameProbe.ush
// Not a shipping look — the HLSL half of the _PixelInstanceFrame regression guard
// (CkTests: CkUsf.PixelInstanceFrame.SetsTheInstanceFrameDefine). It exists to be generated and
// force-compiled, never applied.
//
// Checks NEEDS_, not HAS_: HAS_ also depends on the vertex factory, and a non-instanced permutation of
// the same master legitimately reads the primitive's transform.
#pragma once
#include "/CkUsf/Common.ush"

#if !NEEDS_INSTANCE_WORLD_TO_LOCAL_PS
#error CkUsf InstanceFrameProbe: NEEDS_INSTANCE_WORLD_TO_LOCAL_PS is not set, so _PixelInstanceFrame did not reach the translator
#endif

FCkUsf_SurfaceOutput CkUsf_Look_InstanceFrameProbe(FCkUsf_SurfaceInput In, float ProbeAmount)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();
    O.BaseColor = saturate(ProbeAmount).xxx;
    return O;
}
