// @ckusf surface_graph NativeTranslucentSlab
#pragma once
#include "/CkUsf/TailLampOptics.ush"

FCkUsf_TranslucentSlabOutput CkUsf_Look_OpticalTailLampLens(FCkUsf_SurfaceInput In,
    Texture2D NormalMap, SamplerState NormalMapSampler,
    Texture2D RoughnessMap, SamplerState RoughnessMapSampler,
    Texture2D ThicknessMap, SamplerState ThicknessMapSampler,
    float3 TransmissionColor, float UVScale, float UVRotation, float NormalStrength,
    float RoughnessScale, float RoughnessBias, float Ior, float AbsorptionStrength,
    float ReferenceThicknessCm, float ThicknessCm, float ThicknessVariation, float DistortionStrength)
{
    float2 UV = CkUsf_LibraryUV(In.UV, UVScale, UVRotation);
    FCkUsf_TranslucentSlabOutput O = CkUsf_DefaultTranslucentSlab();
    O.DiffuseAlbedo = 0.0;
    O.EmissiveColor = 0.0;
    O.F0 = CkUsf_TailLampDielectricF0(Ior).xxx;
    O.Normal = CkUsf_LibraryNormal(CkUsf_SampleTexture2D(NormalMap, NormalMapSampler, UV), NormalStrength, UVRotation);
    O.Roughness = clamp(CkUsf_SampleTexture2D(RoughnessMap, RoughnessMapSampler, UV).r * max(RoughnessScale, 0.0) + RoughnessBias, 0.025, 0.9);
    O.TransmittanceColor = CkUsf_TailLampTransmission(TransmissionColor, AbsorptionStrength);
    O.ReferenceThicknessCm = max(ReferenceThicknessCm, 0.001);
    float Thickness = CkUsf_SampleTexture2D(ThicknessMap, ThicknessMapSampler, UV).r;
    O.ThicknessCm = max(ThicknessCm * (1.0 + (Thickness - 0.5) * clamp(ThicknessVariation, 0.0, 1.8)), 0.001);
    // Native PNO uses 1 as its neutral value; IOR controls dielectric F0 above.
    O.RefractionStrength = 1.0 + clamp(DistortionStrength, 0.0, 0.1);
    return O;
}
